# ===== 依赖与构建 =====
node_modules/
dist/
dist-*/
build-verify/
.vite/
# Electron 编译产物（out/main、out/preload；由 npm run electron:compile 生成）
out/
# electron-builder 打包产物（NSIS 安装包 / portable exe / dmg 等，体积大不入库）
release*/
# 预解压的 Electron dist（绕开 Windows Defender 锁 electron.exe 导致 rename EPERM）
.electron-dist/
# 图标生成的临时 HTML（scripts/gen-icon.cjs 运行时产物，正常会自动清理）
build/.icon-render.html
# Pandoc sidecar 二进制（~180MB，由 npm run fetch:pandoc 下载，不入库；.gitkeep 保留目录）
resources/pandoc/*
!resources/pandoc/.gitkeep

# ===== 运行期与临时 =====
*.log
*.tmp
*.bak
*.timestamp-*.mjs
.edge-cdp/
.edge-tmp/
.edge-*/
.uploads/
tmp/
screenshots/

# ===== 根级调试脚本与截图（归档于 archive/ 或按需保留）=====
/*.mjs
/*.png

# ===== 工作区数据（本地工具数据，整体不入远端仓库）=====
# AI 工具工作产物（memory/ 截图笔记、artifacts/ 设计草稿）—— 本地保留，不入远端仓库
.workbuddy/
# AI 工具工作目录（本地工具数据，不入库）
.workbuddy-ai/

# ===== 环境 =====
.env
.DS_Store

# ===== E2E（Playwright）产物 =====
e2e-report/
test-results/
playwright-report/
.playwright/

# 开屏截图（本地验证产物，不入库）
splash-shots/

# ===== 本地开发辅助（不入远端仓库，本地保留）=====
# 一次性画布引擎手测脚本
dev/
# Trae IDE 规则
.trae/

# ===== 官网（已迁出主仓）=====
# 官网项目已迁至 D:/TracSolo_Project/MarkCraft Official Website（原根目录 website/）。
# 保留下面的忽略规则，防止旧路径的残留目录被误提交。
website/


# playwright-cli 会话快照产物
.playwright-cli/
*.yaml
!playwright.config.ts
