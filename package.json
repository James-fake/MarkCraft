{
  "name": "markcraft",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "out/main/index.mjs",
  "description": "MarkCraft —— 本地优先的 Markdown 写作与知识管理桌面应用",
  "author": "MarkCraft",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage --reporter=verbose",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report e2e-report/html",
    "typecheck:electron": "tsc -p tsconfig.electron.json",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "electron:compile": "esbuild electron/main/index.ts --bundle --platform=node --format=esm --external:electron --external:node:* --outfile=out/main/index.mjs && esbuild electron/preload/index.ts --bundle --platform=node --format=cjs --external:electron --external:node:* --outfile=out/preload/index.cjs",
    "electron:dev": "npm run electron:compile && node scripts/start-electron.cjs",
    "electron:start": "npm run build && npm run electron:compile && node scripts/start-electron.cjs --dist",
    "electron:icon": "node scripts/gen-icon.cjs",
    "fetch:pandoc": "node scripts/fetch-pandoc.cjs",
    "electron:prepare-dist": "node scripts/prepare-electron-dist.cjs",
    "electron:pack": "npm run build && npm run electron:compile && npm run electron:prepare-dist && electron-builder --dir",
    "electron:dist": "npm run build && npm run electron:compile && npm run electron:prepare-dist && electron-builder",
    "electron:dist:win": "npm run build && npm run electron:compile && npm run electron:prepare-dist && electron-builder --win --x64",
    "prepare": "husky"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@excalidraw/excalidraw": "^0.17.6",
    "@tiptap/core": "^3.24.0",
    "@tiptap/extension-code-block-lowlight": "^3.24.0",
    "@tiptap/extension-highlight": "^3.24.0",
    "@tiptap/extension-image": "^3.24.0",
    "@tiptap/extension-link": "^3.24.0",
    "@tiptap/extension-placeholder": "^3.24.0",
    "@tiptap/extension-subscript": "^3.24.0",
    "@tiptap/extension-superscript": "^3.24.0",
    "@tiptap/extension-table": "^3.24.0",
    "@tiptap/extension-task-item": "^3.24.0",
    "@tiptap/extension-task-list": "^3.24.0",
    "@tiptap/extension-typography": "^3.24.0",
    "@tiptap/extension-underline": "^3.24.0",
    "@tiptap/pm": "^3.24.0",
    "@tiptap/react": "^3.24.0",
    "@tiptap/starter-kit": "^3.24.0",
    "@types/react-window": "^1.8.8",
    "dexie": "^4.4.4",
    "docx": "^9.7.1",
    "dom-to-image-more": "^3.10.0",
    "dompurify": "^3.4.8",
    "highlight.js": "^11.11.1",
    "html2pdf.js": "^0.14.0",
    "jszip": "^3.10.1",
    "katex": "^0.16.45",
    "lowlight": "^3.3.0",
    "mammoth": "^1.12.0",
    "marked": "^14.1.3",
    "marked-footnote": "^1.4.0",
    "marked-highlight": "^2.2.4",
    "mermaid": "^11.14.0",
    "morphdom": "^2.7.8",
    "pako": "^2.1.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-window": "^2.2.7",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.5",
    "@types/pako": "^2.0.4",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.0.0",
    "autoprefixer": "^10.4.19",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.0",
    "eslint-plugin-local": "file:./scripts/eslint-plugin-local",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "fake-indexeddb": "^6.0.0",
    "husky": "^9.1.7",
    "jsdom": "^24.0.0",
    "lint-staged": "^17.4.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^1.0.0"
  },
  "build": {
    "appId": "com.markcraft.app",
    "productName": "MarkCraft",
    "copyright": "Copyright © 2026 MarkCraft",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "electronDist": ".electron-dist",
    "extraResources": [
      {
        "from": "resources/pandoc",
        "to": "pandoc",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MarkCraft",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown Document",
        "description": "Markdown 文档",
        "role": "Editor"
      },
      {
        "ext": "markdown",
        "name": "Markdown Document",
        "description": "Markdown 文档",
        "role": "Editor"
      }
    ]
  }
}
